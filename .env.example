# Supabase Configuration
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://virxrkjucikhbokqjhve.supabase.co
# Public/anon key — safe to expose in the frontend bundle.
# New Supabase projects show this as a "Publishable key" (sb_publishable_...).
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Secret key (Settings → API Keys → "service_role" / sb_secret_...).
# SERVER-ONLY: bypasses Row Level Security. Never commit it or expose it in
# the frontend. Used only by `npm run seed:blog` to seed posts into Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL (no trailing slash). Used for SEO tags & sitemap.
VITE_SITE_URL=https://nitingavhane.com

# Google AdSense publisher id, e.g. ca-pub-1234567890123456
# Leave blank to disable ads entirely. Ads only load after cookie consent.
VITE_ADSENSE_CLIENT=
